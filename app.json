{
  "expo": {
    "name": "Engest",
    "slug": "Engest",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "engest",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Engest"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      "expo-image",
      "expo-splash-screen",
      "expo-web-browser",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
